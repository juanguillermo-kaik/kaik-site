{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "dist/server/index.js",
  "name": "kaik-creative",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "dist/assets",
    "binding": "ASSETS"
  }
}
